{
  "name": "binary-brotherhood-cloud",
  "private": true,
  "version": "2.0.0",
  "description": "BINARY BROTHERHOOD – Cloudflare Worker (API + Web-App) mit D1-Datenbank",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply binary-brotherhood --local",
    "migrate:remote": "wrangler d1 migrations apply binary-brotherhood --remote",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261103.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.40.0"
  }
}
